[Desktop Entry]
Name=COSMIC Viewer
GenericName=COSMIC Viewer
Comment=View and annotate images
Exec=cosmic-viewer %f
Icon=com.system76.CosmicViewer
Terminal=false
Type=Application
Categories=Graphics;Viewer;
StartupNotify=true
MimeType=image/jpeg;image/png;image/apng;image/gif;image/webp;image/bmp;image/tiff;image/vnd.microsoft.icon;image/x-icon;image/avif;image/heif;image/heic;image/jxl;image/svg+xml;image/jp2;image/x-jp2-codestream;image/qoi;image/x-qoi;image/x-tga;image/vnd.ms-dds;image/x-exr;image/vnd.radiance;image/x-portable-pixmap;image/x-portable-graymap;image/x-portable-bitmap;image/x-portable-anymap;image/x-farbfeld;image/x-adobe-dng;image/x-canon-cr2;image/x-canon-cr3;image/x-canon-crw;image/x-fuji-raf;image/x-hasselblad-3fr;image/x-hasselblad-fff;image/x-kodak-dcr;image/x-kodak-kdc;image/x-minolta-mrw;image/x-nikon-nef;image/x-nikon-nrw;image/x-olympus-orf;image/x-panasonic-rw2;image/x-pentax-pef;image/x-sony-arw;image/x-sony-sr2;image/x-sony-srf;image/x-sigma-x3f;
Keywords=image;photo;picture;viewer;annotate;markup;
Actions=Gallery;

[Desktop Action Gallery]
Name=COSMIC Viewer
Exec=cosmic-viewer
